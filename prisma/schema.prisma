generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  PENDING
  PROCESS
  COMPLETED
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  tasks    Task[]  // Relación con el modelo Task
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  dueDate     DateTime?
  description String
  status      Status   @default(PENDING) // Valor por defecto
  userId      Int      // Campo userId para la relación con User
  user        User     @relation(fields: [userId], references: [id]) // Relación con User
}
